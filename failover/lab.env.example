# Copy to lab.env and edit. Every script in failover/scripts sources this file.
# Defaults match haproxy/haproxy.cfg, haproxy/keepalived/ and prep/inventory.env
# in this repo. Change them together.

# --- Cluster -----------------------------------------------------------------
CLUSTER_NAME=ocp
BASE_DOMAIN=lab.example.com

# --- Load balancers ----------------------------------------------------------
VIP=192.168.100.10
LB1=192.168.100.11
LB2=192.168.100.12
# SSH user on the LBs; must be able to run sudo without a password prompt.
LB_SSH_USER=cloud-user
# keepalived VRRP instance name, as in keepalived.conf
VRRP_INSTANCE=VI_OCP
# NIC carrying the VIP and VRRP (its firewalld zone is used by vrrp-block)
LB_IFACE=ens192
# HAProxy built-in Prometheus exporter (frontend prometheus in haproxy.cfg)
HAPROXY_METRICS_PORT=8405

# --- Topology -----------------------------------------------------------------
EXPECTED_MASTERS=3
EXPECTED_INFRA=2

# --- HAProxy backend names (proxy="..." label in haproxy_server_status) ------
HAPROXY_API_BACKEND=api_backend
HAPROXY_MCS_BACKEND=machine_config_backend
HAPROXY_HTTPS_BACKEND=ingress_https_backend
HAPROXY_HTTP_BACKEND=ingress_http_backend

# --- Probe settings ----------------------------------------------------------
# Seconds between probe rounds and per-request timeout.
PROBE_INTERVAL=0.5
PROBE_TIMEOUT=2
# How long each test waits for an expected state before failing (seconds).
WAIT_TIMEOUT=120
# Node reboots take longer.
NODE_WAIT_TIMEOUT=900

# --- Pass criteria (seconds of client-visible failure) -----------------------
MAX_VIP_FAILOVER_OUTAGE=10
MAX_BACKEND_LOSS_OUTAGE=10
