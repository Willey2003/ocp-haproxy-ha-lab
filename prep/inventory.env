# ---------------------------------------------------------------------------
# Lab inventory: single source of truth for the prep scripts.
# All values are PLACEHOLDERS. Replace them with your real addressing before use.
# Scripts in this directory source this file:  source ./inventory.env
# ---------------------------------------------------------------------------

# Cluster naming: OpenShift expects <cluster_name>.<base_domain>
CLUSTER_NAME="ocp"
BASE_DOMAIN="lab.example.com"
CLUSTER_DOMAIN="${CLUSTER_NAME}.${BASE_DOMAIN}"      # ocp.lab.example.com

# Machine network (all nodes + load balancers)
MACHINE_CIDR="192.168.100.0/24"
REVERSE_ZONE="100.168.192.in-addr.arpa"
GATEWAY="192.168.100.1"

# DNS servers (primary/secondary BIND). Use two for production.
DNS1_IP="192.168.100.5"
DNS2_IP="192.168.100.6"

# Admin / management network allowed to reach HAProxy stats + metrics + SSH
MGMT_CIDR="10.10.0.0/24"

# Load balancer pair (HAProxy + keepalived) and the shared virtual IP
LB_VIP="192.168.100.10"
LB1_NAME="lb1";  LB1_IP="192.168.100.11"
LB2_NAME="lb2";  LB2_IP="192.168.100.12"
LB_IFACE="ens192"          # NIC that carries the VIP and VRRP traffic
VRRP_ROUTER_ID="51"        # must be unique per L2 segment

# Control plane
BOOTSTRAP_NAME="bootstrap"; BOOTSTRAP_IP="192.168.100.20"   # install-time only
MASTER0_NAME="master0";     MASTER0_IP="192.168.100.21"
MASTER1_NAME="master1";     MASTER1_IP="192.168.100.22"
MASTER2_NAME="master2";     MASTER2_IP="192.168.100.23"

# Infra nodes (run the OpenShift routers)
INFRA0_NAME="infra0";       INFRA0_IP="192.168.100.31"
INFRA1_NAME="infra1";       INFRA1_IP="192.168.100.32"

# Ports fronted / exposed by HAProxy
PORT_API="6443"            # Kubernetes API -> masters (+ bootstrap during install)
PORT_MCS="22623"           # Machine Config Server -> masters (+ bootstrap), internal only
PORT_HTTP="80"             # Ingress HTTP  -> infra routers
PORT_HTTPS="443"           # Ingress HTTPS -> infra routers
PORT_STATS="9000"          # HAProxy stats page (mgmt network only)
PORT_METRICS="8405"        # HAProxy Prometheus exporter (mgmt network only)
PORT_ROUTER_HEALTH="1936"  # OpenShift router health endpoint used by HAProxy checks
